# Local development only. Do not reuse these values outside a developer machine.
APP_NAME=tourism-backend
APP_ENV=local
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

DATABASE_URL=postgresql+asyncpg://tourism:local-tourism-password@localhost:5433/tourism
DATABASE_URL_SYNC=postgresql+psycopg://tourism:local-tourism-password@localhost:5433/tourism
REDIS_URL=redis://localhost:6380/0

# Auth (Phase 6).
JWT_SIGNING_KEY=local-jwt-signing-key-dev-only-not-for-prod
JWT_ISSUER=crimeatrip-local
JWT_AUDIENCE=crimeatrip-mobile
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# Accept any OTP code. Defaults to true only for APP_ENV=local; the server refuses
# to start with it enabled in staging/production.
# AUTH_OTP_ACCEPT_ANY=true
# Keep the generated code readable in auth_otp_challenges.debug_code while no SMS
# provider is connected. Defaults to true for local/test, refused in staging/production.
# AUTH_OTP_STORE_DEBUG_CODE=true

# Phase 6.5 ops admin (SQLAdmin at /admin). Separate cookie session from mobile JWT.
ADMIN_ENABLED=true
ADMIN_SESSION_SECRET=local-admin-session-secret-dev-only-not-for-prod
# Optional bootstrap principal (local/test DX). Omit in staging/production unless intentional.
ADMIN_BOOTSTRAP_LOGIN=ops
ADMIN_BOOTSTRAP_PASSWORD=local-admin-password-change-me

# AI planning (Phase 8B+). Settings/provider smoke are wired; user-facing route
# generation remains disabled until the deterministic builder is implemented.
# Do not put real API keys here or in commits. See tourism-platform/docs/stack.md
# AI_PLANNING_ENABLED=false
# AI_PROVIDER=mock
# mock | gemini | ollama | lmstudio
# AI_MODEL=
# AI_REQUEST_TIMEOUT_SECONDS=30
# AI_MAX_REPAIR_ATTEMPTS=1
# AI_PROMPT_VERSION=v1
# GEMINI_API_KEY=
# GEMINI_MODEL=
# Home lab (GPU host, never the constrained test VPS):
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_CHAT_MODEL=gemma4:12b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# Windows LM Studio (OpenAI-compatible; only over private Tailscale/WireGuard):
# LM_STUDIO_BASE_URL=http://100.x.y.z:1234/v1
# LM_STUDIO_MODEL=google/gemma-4-26b-a4b
# LM_STUDIO_API_KEY=
# QDRANT_URL=http://127.0.0.1:6333
# RAG_ENABLED=false

# FCM HTTP v1 (optional system push). Leave unset for in-app inbox only.
# Never commit the service account JSON. See docs/push-notifications-fcm.md.
# FCM_SERVICE_ACCOUNT_JSON=
# FCM_SERVICE_ACCOUNT_FILE=/secrets/fcm-service-account.json
